
# Server
PORT=5000
NODE_ENV=development


MONGODB_URI=

JWT_SECRET=

# Cloudinary (for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (used for password reset links, CORS, etc.)
FRONTEND_URL=http://localhost:5173

# Google / AI (if used)
# Either a simple API key or path to credentials depending on provider
GOOGLE_API_KEY=
# or for service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=

# Email (SMTP) - used by sendEmail service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Sentry DSN for error reporting
SENTRY_DSN=

# Optional: Redis (if you add job queueing or caching)
REDIS_URL=

# Optional: file uploads / storage configuration
# If you switch to persistent disk storage, set an uploads folder path
UPLOADS_PATH=public/uploads

